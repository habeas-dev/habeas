{
  "id": "caixabank-consumer-es",
  "name": "CaixaBank Consumer — extractos",
  "service": "caixabank-consumer",
  "trust": "first-party",
  "credit": {
    "author": {
      "name": "David Marín",
      "url": "https://davefx.com"
    },
    "capture": {
      "name": "David Marín",
      "url": "https://davefx.com"
    }
  },
  "domain": "caixabankconsumer.com",
  "country": "ES",
  "currency": "EUR",
  "categories": [
    "card"
  ],
  "crossDomainHosts": [
    "api.caixabankpc.com"
  ],
  "match": [
    "https://clientes.caixabankconsumer.com/*"
  ],
  "openUrl": "https://clientes.caixabankconsumer.com/cpc/tarjetas",
  "auth": {
    "mode": "bearer",
    "tokenMatch": "^Bearer [0-9a-f-]{20,}$",
    "replayHeaders": [
      "authorization"
    ],
    "context": [
      {
        "name": "dni",
        "from": "url",
        "match": "/posicionGlobal/es/([0-9A-Za-z]+)"
      }
    ],
    "loginUrl": "https://clientes.caixabankconsumer.com/cpc/login"
  },
  "api": {
    "host": "https://api.caixabankpc.com",
    "groups": {
      "path": "/cpc/v1.0/portalCliente/posicionGlobal/es/{ctx.dni}",
      "itemsPath": "listaProductos",
      "fields": {
        "id": "numeroContrato",
        "numeroContrato": "numeroContrato",
        "marca": "marca",
        "name": "marcaDescripcion",
        "card": "numeroTarjeta"
      },
      "mask": [
        "card"
      ]
    },
    "list": {
      "path": "/cpc/v1.0/crm365/contratos/tarjetas/extractos/consultaonline",
      "method": "POST",
      "contentType": "application/json",
      "paging": "none",
      "itemsPath": "Extractos",
      "window": "5y",
      "body": "{\"Contrato\":\"{group.numeroContrato}\",\"DNI\":\"{ctx.dni}\",\"Marca\":\"{group.marca}\",\"FechaDesde\":\"{fromDate}\",\"FechaHasta\":\"{toDate}\",\"Idioma\":\"es\"}"
    },
    "pdf": {
      "urlField": "Url"
    }
  },
  "fields": {
    "internalId": "Codigo",
    "date": "FechaHasta",
    "number": "Codigo",
    "issuer": "Marca"
  },
  "schema": "invoice@1",
  "minVersion": "0.1.35",
  "version": "2026-08-26",
  "changelog": [
    {
      "version": "2026-08-26",
      "changes": {
        "en": "Records authorship: the session was recorded and the definition written by the maintainer. No change to extraction.",
        "es": "Registra la autoría: la sesión la grabó y la definición la escribió el mantenedor. No cambia la extracción."
      }
    },
    {
      "version": "2026-08-08",
      "changes": {
        "en": "No change to what this source extracts. This version gave it its guide page on habeas.dev.",
        "es": "Sin cambios en lo que extrae esta fuente. Esta versión le dio su página de guía en habeas.dev."
      }
    },
    {
      "version": "2026-07-08",
      "changes": {
        "en": "Initial version: statements (cross-domain api.caixabankpc.com), DNI capture, PDF by absolute URL.",
        "es": "Versión inicial: extractos (cross-domain api.caixabankpc.com), captura de DNI, PDF por URL absoluta."
      }
    }
  ],
  "content": {
    "en": {
      "slug": "caixabank-consumer-statements",
      "docs": "card statements",
      "h1": "How to download your CaixaBank Consumer statements",
      "intro": "Your CaixaBank Consumer card statements are available as PDFs, one per period, with no combined download."
    },
    "es": {
      "slug": "extractos-caixabank-consumer",
      "docs": "extractos de tarjeta",
      "h1": "Cómo descargar tus extractos de CaixaBank Consumer",
      "intro": "Los extractos de tu tarjeta de CaixaBank Consumer están disponibles en PDF, uno por periodo, sin opción de descarga conjunta."
    }
  },
  "brand": "CaixaBank Consumer"
}
