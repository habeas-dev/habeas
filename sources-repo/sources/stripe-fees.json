{
  "id": "stripe-fees",
  "name": "Stripe — facturas de comisiones",
  "service": "stripe",
  "trust": "first-party",
  "beta": true,
  "credit": {
    "author": { "name": "David Marín", "url": "https://davefx.com" },
    "capture": { "name": "David Marín", "url": "https://davefx.com" }
  },
  "domain": "stripe.com",
  "categories": ["banking"],
  "crossDomainHosts": ["stripe-tax-docs.s3.amazonaws.com"],
  "match": ["https://dashboard.stripe.com/*"],
  "openUrl": "https://dashboard.stripe.com/settings/plans-and-fees/invoice-history",
  "auth": {
    "mode": "bearer",
    "tokenMatch": "^Bearer uk_[A-Za-z0-9_]{20,}$",
    "replayHeaders": ["authorization", "stripe-account", "stripe-livemode"],
    "capturePaths": ["/v1/"],
    "context": [{ "name": "acct", "from": "url", "match": "/v1/accounts/(acct_[A-Za-z0-9]+)" }],
    "loginUrl": "https://dashboard.stripe.com/login"
  },
  "api": {
    "host": "https://dashboard.stripe.com",
    "groups": {
      "path": "/v1/accounts/{ctx.acct}",
      "itemsPath": "",
      "fields": { "id": "id", "label": "settings.dashboard.display_name" }
    },
    "list": {
      "path": "/v1/settings/plans_and_fees/invoice_history_documents",
      "paging": "none",
      "itemsPath": "data"
    },
    "pdf": { "path": "/download/tax/vat/{internalId}" }
  },
  "fields": {
    "internalId": "token",
    "number": "invoiceNumber",
    "date": "createdString",
    "description": "description",
    "periodStart": "periodStartInclusive",
    "periodEnd": "periodEndExclusive",
    "reverseCharge": "reverseCharge",
    "corrected": "corrected",
    "credited": "credited",
    "recipientTaxId": "regenerationDetails.vatId",
    "issuerName": { "const": "Stripe Payments Europe, Limited" },
    "issuerCountry": { "const": "IE" },
    "type": { "const": "fee_invoice" },
    "category": { "const": "banking" }
  },
  "schema": "invoice@2",
  "minVersion": "0.10.11.8",
  "version": "2026-11-25",
  "changelog": [
    {
      "version": "2026-11-25",
      "changes": {
        "en": "First version: Stripe's monthly fee invoices (PDF), for the account open in the dashboard.",
        "es": "Primera versión: las facturas mensuales de comisiones de Stripe (PDF), de la cuenta abierta en el panel."
      }
    }
  ],
  "content": {
    "en": {
      "slug": "stripe-fee-invoices",
      "docs": "fee invoices",
      "h1": "Download all your Stripe fee invoices at once",
      "intro": "Stripe bills its fees with a monthly tax invoice that is only available as a PDF in the dashboard, one by one, with no API.",
      "title": "How to download your Stripe fee invoices"
    },
    "es": {
      "slug": "facturas-comisiones-stripe",
      "docs": "facturas de comisiones",
      "h1": "Descarga todas tus facturas de comisiones de Stripe de una vez",
      "intro": "Stripe factura sus comisiones con una factura mensual que solo se puede descargar en PDF desde el panel, una a una y sin API.",
      "title": "Cómo descargar tus facturas de comisiones de Stripe"
    }
  },
  "brand": "Stripe"
}
