{
  "id": "leroymerlin-es",
  "name": "Leroy Merlin España",
  "service": "leroymerlin",
  "trust": "community",
  "domain": "leroymerlin.es",
  "country": "ES",
  "categories": [
    "diy"
  ],
  "match": [
    "https://www.leroymerlin.es/*"
  ],
  "openUrl": "https://www.leroymerlin.es/mi-cuenta/mis-compras/historial",
  "auth": {
    "mode": "cookie",
    "replayHeaders": [],
    "loginUrl": "https://www.leroymerlin.es/login.html"
  },
  "itemLabel": "Pedido {internalId}",
  "api": {
    "host": "https://www.leroymerlin.es"
  },
  "streams": [
    {
      "id": "tickets",
      "name": "Tickets de tienda",
      "schema": "receipt@1",
      "categories": [
        "diy"
      ],
      "api": {
        "list": {
          "headers": {
            "content-type": "application/json"
          },
          "itemsPath": "receipts",
          "pageParam": "yearOffset",
          "pageStart": 0,
          "stopAfterEmpty": 3,
          "paging": "page",
          "params": {
            "page": "0",
            "size": "10"
          },
          "path": "/customer-space-module/services/customer-after-sales-backend/me/receipts"
        },
        "detail": {
          "headers": {
            "content-type": "application/json"
          },
          "method": "GET",
          "path": "/customer-space-module/services/customer-after-sales-backend/me/receipts/{internalId}"
        }
      },
      "fields": {
        "date": "date",
        "internalId": "id",
        "number": "number",
        "storeName": "store.storeName",
        "total": "totalPriceIncludingVAT.amount"
      }
    },
    {
      "id": "pedidos",
      "name": "Pedidos",
      "schema": "receipt@1",
      "categories": [
        "diy"
      ],
      "api": {
        "list": {
          "headers": {
            "content-type": "application/json"
          },
          "path": "/order-followup/backend/v2/orders",
          "paging": "none",
          "itemsPath": "$"
        }
      },
      "fields": {
        "internalId": "orderPartNumber",
        "date": "parentOrder.createdAt",
        "total": "price.totalAmount",
        "storeName": "vendors.0.name"
      }
    }
  ],
  "version": "2026-08-08",
  "minVersion": "0.1.53.13",
  "changelog": [
    {
      "version": "2026-08-08",
      "changes": "Añade `content` (copy bilingüe de la guía en habeas.dev) y `brand`. La página por fuente pasa a generarse desde la propia definición, no desde un fichero aparte en la web."
    },
    {
      "version": "2026-07-10.3",
      "changes": "Tickets: no cortar al llegar a un año sin compras (stopAfterEmpty) — antes se paraba en 2025 (sin compras) y ocultaba los tickets más antiguos."
    },
    {
      "version": "2026-07-10.2",
      "changes": "Stream «Pedidos»: mostrar TODOS los pedidos de «mis pedidos» (se quita el filtro que dejaba solo los ONLINE y ocultaba pedidos de tienda que también aparecen ahí)."
    },
    {
      "version": "2026-07-10.1",
      "changes": "Tickets de tienda: empezar en el año actual (yearOffset 0) — antes empezaba 2 años atrás y se saltaba las compras de este año y el anterior."
    },
    {
      "version": "2026-07-10",
      "changes": "Añade compras online (stream «Pedidos online» vía /order-followup/backend/v2/orders, filtradas a ONLINE) junto a los tickets de tienda existentes; fuente multi-salida (streams)."
    },
    {
      "version": "2026-07-08",
      "changes": "Recibos vía API JSON (cookie)."
    }
  ],
  "content": {
    "en": {
      "slug": "leroy-merlin-receipts",
      "docs": "receipts and orders",
      "h1": "How to download your Leroy Merlin receipts and orders",
      "intro": "Leroy Merlin keeps in-store receipts separate from online orders. Both live in your account and neither can be downloaded in bulk."
    },
    "es": {
      "slug": "tickets-leroy-merlin",
      "docs": "tickets y pedidos",
      "h1": "Cómo descargar tus tickets y pedidos de Leroy Merlin",
      "intro": "Leroy Merlin separa los tickets de tienda de los pedidos online. Ambos están en tu cuenta y ninguno se puede descargar en bloque."
    }
  },
  "brand": "Leroy Merlin"
}
